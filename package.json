{
  "name": "@anime-fan-5903/dsh-sync",
  "repository": { "type": "git", "url": "git+https://github.com/anime-fan-5903/dsh-sync.git" },
  "homepage": "https://github.com/anime-fan-5903/dsh-sync#readme",
  "bugs": { "url": "https://github.com/anime-fan-5903/dsh-sync/issues" },
  "keywords": ["dsh", "deepseek-harness", "sync", "onedrive", "skills"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "version": "0.3.4",
  "license": "GPL-3.0-only",
  "description": "Synchronize DSH instructions, Skills, portable settings, model configuration and plugin declarations across devices with optional cloud encryption.",
  "type": "module",
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "src/", "locale/", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "README.ja.md", "LICENSE", "docs/", "AGENTS.md", "CONTRIBUTING.md", "scripts/", "test/"],
  "scripts": { "test": "node --test", "check": "node scripts/check.mjs", "locales": "node scripts/locales.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-session-controller"] }
  }
}
